# syntax=docker/dockerfile:1.7
#
# Multi-stage Dockerfile that builds the AFFiNE backend entirely from source.
# No local pre-building required — suitable for CI/CD platforms like Dokploy.

# ============================================================
# Stage 1: Build Rust native module + server bundle
# ============================================================
FROM node:22-bookworm AS builder

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      curl build-essential python3 pkg-config libssl-dev clang ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Install Rust (matching rust-toolchain.toml)
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | \
    sh -s -- -y --default-toolchain 1.94.0 --profile default
ENV PATH="/root/.cargo/bin:${PATH}"

WORKDIR /build

# Copy the full repo — .dockerignore keeps the context manageable
COPY . .

# Install all dependencies (including devDependencies for build tooling)
RUN yarn install

# Build the Rust native module
RUN yarn workspace @affine/server-native build --target x86_64-unknown-linux-gnu

# Build the server bundle (rspack)
RUN yarn workspace @affine/server build

# ============================================================
# Stage 2: Collect production node_modules
# ============================================================
FROM node:22-bookworm-slim AS deps

WORKDIR /build

# Copy workspace structure for yarn resolution
COPY --from=builder /build/package.json /build/yarn.lock /build/.yarnrc.yml ./
COPY --from=builder /build/.yarn/ ./.yarn/

# We need all workspace package.json files for focus to resolve correctly
COPY --from=builder /build/packages/ ./packages/
COPY --from=builder /build/tools/ ./tools/
COPY --from=builder /build/blocksuite/ ./blocksuite/
COPY --from=builder /build/docs/ ./docs/
COPY --from=builder /build/tests/ ./tests/

# Clean out source/dist from the copy — we only need package.json files + schema
RUN find packages tools blocksuite docs tests \
      -type f ! -name "package.json" ! -name "schema.prisma" \
      -not -path "*/migrations/*" \
      -delete 2>/dev/null; \
    find packages tools blocksuite docs tests \
      -type d -empty -delete 2>/dev/null; \
    true

RUN yarn workspaces focus @affine/server --production
RUN yarn workspace @affine/server prisma generate

# ============================================================
# Stage 3: Final minimal runtime image
# ============================================================
FROM node:22-bookworm-slim

RUN apt-get update && \
    apt-get install -y --no-install-recommends openssl libjemalloc2 && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Production node_modules
COPY --from=deps /build/node_modules ./node_modules
COPY --from=deps /build/node_modules/.prisma ./node_modules/.prisma

# Built server bundle
COPY --from=builder /build/packages/backend/server/dist ./dist

# Native binding
COPY --from=builder /build/packages/backend/native/server-native.node ./dist/server-native.x64.node

# Runtime scripts, schema, and migrations
COPY --from=builder /build/packages/backend/server/scripts ./scripts
COPY --from=builder /build/packages/backend/server/schema.prisma ./schema.prisma
COPY --from=builder /build/packages/backend/server/migrations ./migrations
COPY --from=builder /build/packages/backend/server/package.json ./package.json

ENV LD_PRELOAD=libjemalloc.so.2
ENV NODE_ENV=production

EXPOSE 3010

CMD ["node", "./dist/main.js"]
